{
  "name": "clientsignal-backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev:gateway": "tsx watch apps/api-gateway/src/main.ts",
    "dev:auth": "tsx watch apps/auth-service/src/main.ts",
    "dev:attorney": "tsx watch apps/attorney-service/src/main.ts",
    "dev:lead": "tsx watch apps/lead-service/src/main.ts",
    "dev:case": "tsx watch apps/case-service/src/main.ts",
    "dev:messaging": "tsx watch apps/messaging-service/src/main.ts",
    "dev:mail": "tsx watch apps/mail-service/src/main.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f docker-compose.dev.yml down",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@grpc/grpc-js": "^1.13.0",
    "@grpc/proto-loader": "^0.7.13",
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/platform-socket.io": "^11.1.24",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.24",
    "@socket.io/redis-adapter": "^8.3.0",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.2.0",
    "nats": "^2.29.0",
    "pg": "^8.21.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.2.0",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "typescript-eslint": "^8.60.1"
  }
}
