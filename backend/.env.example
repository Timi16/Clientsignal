# ── API Gateway ─────────────────────────────────────────────
API_PORT=4000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ── Auth / JWT ──────────────────────────────────────────────
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=
ALLOW_ADMIN_REGISTRATION=true

# ── Databases (one per service) ─────────────────────────────
# NOTE: do NOT set a global DATABASE_URL here — every service and
# drizzle config would point at the same database.
AUTH_DATABASE_URL=postgres://postgres:postgres@localhost:5434/cs_auth
ATTORNEY_DATABASE_URL=postgres://postgres:postgres@localhost:5434/cs_attorney
LEAD_DATABASE_URL=postgres://postgres:postgres@localhost:5434/cs_lead
CASE_DATABASE_URL=postgres://postgres:postgres@localhost:5434/cs_case
MESSAGING_DATABASE_URL=postgres://postgres:postgres@localhost:5434/cs_messaging
MAIL_DATABASE_URL=postgres://postgres:postgres@localhost:5434/cs_mail

# ── Messaging / events ──────────────────────────────────────
NATS_URL=nats://localhost:4222

# ── gRPC service addresses (gateway → services) ─────────────
# NOTE: do NOT set GRPC_PORT here — all services share this .env
# and each has its own default port (auth 5001, attorney 5002,
# lead 5003, case 5004, messaging 5005).
AUTH_GRPC_URL=localhost:5001
ATTORNEY_GRPC_URL=localhost:5002
LEAD_GRPC_URL=localhost:5003
CASE_GRPC_URL=localhost:5004
MESSAGING_GRPC_URL=localhost:5005

# ── Mail (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_placeholder_replace_me
RESEND_WEBHOOK_SECRET=

# ── AI verification (Groq) — optional, falls back to manual ─
GROQ_API_KEY=

# ── File storage (Cloudflare R2) — optional in dev ──────────
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clientssignal
R2_PUBLIC_URL=
